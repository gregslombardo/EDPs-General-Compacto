from pathlib import Path
import re, sys, nbformat
root = Path(__file__).resolve().parents[1]
errors=[]
checked=0
for p in sorted(root.rglob('*.ipynb')):
    nb=nbformat.read(p,as_version=4)
    checked += 1
    for i,c in enumerate(nb.cells):
        if c.cell_type == 'raw':
            errors.append(f'{p}: celda {i} es RAW')
        if c.cell_type == 'markdown':
            for forbidden in (r'\(',r'\)',r'\[',r'\]',r'\tag{'):
                if forbidden in c.source:
                    errors.append(f'{p}: celda {i}: {forbidden}')
            for block in re.findall(r'```.*?```', c.source, flags=re.S):
                if '$' in block or '\\begin{' in block or '\\frac' in block or '\\int' in block:
                    errors.append(f'{p}: celda {i}: matemáticas en bloque de código')
        if c.cell_type == 'code':
            if c.get('execution_count') is not None:
                errors.append(f'{p}: celda {i}: execution_count no vacío')
            if c.get('outputs'):
                errors.append(f'{p}: celda {i}: outputs no vacíos')
if errors:
    print('VALIDACIÓN FALLIDA')
    print('\n'.join(errors))
    sys.exit(1)
print(f'VALIDACIÓN CORRECTA: {checked} notebook(s) revisado(s).')
